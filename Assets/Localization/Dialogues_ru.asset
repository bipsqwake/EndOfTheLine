  m_TableData:
  - m_Id: 4304273399808
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 4304306954240
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E\u0435 \u0443\u0442\u0440\u043E?
      \u041F\u043E\u0440\u0430 \u0437\u0430\u043A\u0438\u043D\u0443\u0442\u044C \u0435\u0449\u0451
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u0433\u043B\u044F \u0432
      \u0442\u043E\u043F\u043A\u0443. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u0432\u0430\u0436\u043D\u044B\u0439 \u0434\u0435\u043D\u044C, \u0441\u0430\u043B\u0430\u0433\u0430,
      \u0442\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148545
    m_Localized: "\u0416\u0434\u0443 \u043D\u0435 \u0434\u043E\u0436\u0434\u0443\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148546
    m_Localized: "\u042F \u0443\u0436\u0435 \u0443\u043C\u0435\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148547
    m_Localized: "\u041A\u0430\u043A \u043A\u0441\u0442\u0430\u0442\u0438 \u043C\u044B
      \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E\u0435\u0437\u0434 \u0442\u0440\u0430\u0443\u0442\u043E\u0432.
      \u0418\u0442\u0430\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148548
    m_Localized: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043F\u043E \u043D\u043E\u0447\u0430\u043C
      \u0442\u044B \u0447\u0438\u0442\u0430\u043B \u043D\u0435 \u043A\u043E\u043C\u0438\u043A\u0441\u044B,
      \u0430 \u043C\u0430\u043D\u0443\u0430\u043B\u044B? \u041F\u043E\u0445\u0432\u0430\u043B\u044C\u043D\u043E.
      \u0410 \u0432\u043E\u0442 \u0438 \u0442\u0432\u043E\u0439 \u0448\u0430\u043D\u0441
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0442\u044B
      \u0443\u043C\u0435\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 134665850576896
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u043D\u0430\u0443\u0447\u0438\u0448\u044C\u0441\u044F
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u044D\u0442\u0438\u043C
      \u043F\u043E\u0435\u0437\u0434\u043E\u043C. \u0412 \u043A\u043E\u043D\u0446\u0435
      \u043A\u043E\u043D\u0446\u043E\u0432 \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u044B
      \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0437\u0430\u0439\u043C\u0451\u0448\u044C
      \u043C\u043E\u0451 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 3204242079735808
    m_Localized: "\u041A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A!"
    m_Metadata:
      m_Items: []
