  m_Name: Dialogues_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: c88d164ac2fdb49e9af383d5d9fd6c78, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4304273399808
    m_Localized: Engineer
    m_Metadata:
      m_Items: []
  - m_Id: 4304306954240
    m_Localized: What a great morning! It's time to put some more coal in the furnace.
      It's an important day, rookie, do you remember?
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148545
    m_Localized: I can't wait
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148546
    m_Localized: I already can
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148547
    m_Localized: How coincidental that we stumbled upon the Trout reconnaissance
      train. Well...
    m_Metadata:
      m_Items: []
  - m_Id: 4304311148548
    m_Localized: Did you really read manuals instead of comics at night? Commendable.
      And here's your chance to show what you can do.
    m_Metadata:
      m_Items: []
  - m_Id: 134665850576896
    m_Localized: Today you will learn how to drive this train. After all, you're
      the one who's going to take my place one day.
    m_Metadata:
      m_Items: []
  - m_Id: 3204242079735808
    m_Localized: Good job!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
